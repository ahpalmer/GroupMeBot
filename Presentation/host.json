{
  "version": "2.0",
  "telemetryMode": "openTelemetry",
  "extensions": {
    "queues": {
      "messageEncoding": "base64"
    }
  },
  "logging": {
    "logLevel": {
      "default": "Information",
      "Host.Results": "Error",
      "Function": "Error",
      "Host.Aggregator": "Trace"
    }
  }
}